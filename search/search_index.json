{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":["stopWordFilter"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"Home","text":"<p>\u7f51\u683c\u53d8\u5f62\u8fc1\u79fb\u76f8\u5173\u7684\u7b14\u8bb0</p> <p>\u6211\u7684\u6d4b\u8bd5</p>"},{"location":"%E7%9B%B8%E5%85%B3%E6%80%A7%E8%AE%A1%E7%AE%97/%E7%9B%B8%E5%85%B3%E6%80%A7%E8%AE%A1%E7%AE%97/","title":"\u76f8\u5173\u6027\u8ba1\u7b97","text":""},{"location":"%E7%9B%B8%E5%85%B3%E6%80%A7%E8%AE%A1%E7%AE%97/%E7%9B%B8%E5%85%B3%E6%80%A7%E8%AE%A1%E7%AE%97/#1","title":"1 \u670d\u88c5\u4e0e\u4eba\u4f53\u9762\u76f8\u5173\u6027\u8ba1\u7b97","text":"<p>\u67e5\u627e\u79bb\u6bcf\u4e2a\u670d\u88c5\u9762\u6700\u8fd1\u7684\u4eba\u4f53\u9762\uff0c\u8fd9\u79cd\u65b9\u6cd5\u5f88\u5feb\u901f\uff0c\u4f46\u662f\u4f1a\u6709\u4e00\u4e9b\u9762\u9519\u8bef\u5339\u914d</p> \u7531\u4e8e\u8936\u76b1\uff0c\u8fd9\u4e9b\u670d\u88c5\u9762\u4e0e\u4eba\u4f53\u9762\u6cd5\u7ebf\u4e0d\u4e00\u81f4 \u5728\u8896\u53e3\u548c\u88c6\u90e8\u7b49\u4f4d\u7f6e\uff0c\u5bb9\u6613\u9519\u8bef\u5339\u914d <p>\u5224\u65admesh\u662f\u4e0d\u662fwatertight <pre><code>import trimesh\n\n# CLO\u865a\u62df\u6a21\u7279\u7f51\u683c\u4e0d\u662fwatertight\uff0cSMPL\uff0cSTAR\u7f51\u683c\u662fwatertight\n\nmesh = trimesh.load_mesh(\"final_star.obj\")\nprint(mesh.is_watertight)\n</code></pre></p> <p>\u5019\u9009\u641c\u7d22 + \u90bb\u57df\u8ddd\u79bb\u7ea6\u675f</p> <p>\u4f60\u4e0d\u5e94\u8be5\u5148\u72ec\u7acb\u5730\u4e3a\u6bcf\u4e2a\u670d\u88c5\u9762\u786e\u5b9a\u552f\u4e00\u5339\u914d\uff0c\u518d\u8bd5\u56fe\u4fee\u590d\u9519\u8bef\u3002\u66f4\u597d\u7684\u529e\u6cd5\u662f\uff1a\u6bcf\u4e2a\u670d\u88c5\u9762\u4fdd\u7559\u591a\u4e2a\u5019\u9009\u4eba\u4f53\u9762\uff0c\u7136\u540e\u8054\u5408\u76f8\u90bb\u670d\u88c5\u9762\u7684\u5339\u914d\u5173\u7cfb\u8fdb\u884c\u9009\u62e9\u3002</p> <p>\u9700\u8981\u5f3a\u8c03\u7684\u662f\uff1a\u4e0d\u8981\u76f4\u63a5\u628a\u6240\u6709\u4eba\u4f53\u9762\u662f\u5426\u76f8\u90bb\u4f5c\u4e3a\u8fde\u7eed\u6027\u5224\u65ad\u6761\u4ef6\uff0c\u4e5f\u4e0d\u8981\u4f7f\u7528\u56fa\u5b9a\u7684\u7edd\u5bf9\u8ddd\u79bb\u9608\u503c\u3002 \u5e94\u8be5\u8ba9\u9608\u503c\u968f\u5c40\u90e8\u7f51\u683c\u5c3a\u5ea6\u53d8\u5316\uff0c\u5e76\u901a\u8fc7\u6837\u672c\u7edf\u8ba1\u6821\u51c6\u3002</p> <ol> <li>\u8bfb\u53d6\u6e90\u4eba\u4f53\u3001\u76ee\u6807\u4eba\u4f53\u3001\u6e90\u670d\u88c5\u3002</li> <li>\u5efa\u7acb\u4eba\u4f53\u9876\u70b9\u6216\u4e09\u89d2\u5f62\u5bf9\u5e94\u5173\u7cfb\u3002</li> <li>\u8ba1\u7b97\u6bcf\u4e2a\u4eba\u4f53\u4e09\u89d2\u5f62\u7684\u5c40\u90e8\u5f62\u53d8\u68af\u5ea6\u3002</li> <li>\u4e3a\u6bcf\u4e2a\u6e90\u670d\u88c5\u9876\u70b9\u5efa\u7acb\u4eba\u4f53\u5bf9\u5e94\u4e09\u89d2\u5f62\u548c\u91cd\u5fc3\u5750\u6807\u3002</li> <li>\u8ba1\u7b97\u4eba\u4f53\u5f62\u53d8\u9a71\u52a8\u7684\u76ee\u6807\u670d\u88c5\u521d\u59cb\u4f4d\u7f6e\u3002</li> <li>\u5728 PyTorch \u4e2d\u4f18\u5316\u76ee\u6807\u670d\u88c5\u9876\u70b9\uff0c\u4f7f\u670d\u88c5\u5c40\u90e8\u68af\u5ea6\u5c3d\u91cf\u5339\u914d\u4eba\u4f53\u5c40\u90e8\u68af\u5ea6\u3002</li> <li>\u52a0\u5165\u53c2\u8003\u5f62\u72b6\u3001\u5e73\u6ed1\u3001\u95f4\u8ddd\u548c\u78b0\u649e\u635f\u5931\u3002</li> <li>\u4f7f\u7528 PyTorch3D \u53ef\u89c6\u5316\u3001\u68c0\u67e5\u5e76\u5bfc\u51fa\u76ee\u6807\u670d\u88c5</li> </ol>"},{"location":"%E7%9B%B8%E5%85%B3%E6%80%A7%E8%AE%A1%E7%AE%97/%E7%AC%94%E8%AE%B0/","title":"\u7b14\u8bb0","text":"<p>\u4f60\u7684\u8fd9\u4e2a\u601d\u8def\u662f\u53ef\u884c\u7684\uff0c\u800c\u4e14\u53ef\u4ee5\u628a\u95ee\u9898\u660e\u786e\u5730\u5b9a\u4e49\u4e3a\u4e00\u4e2a\u4eba\u4f53\u5f62\u53d8\u68af\u5ea6\u9a71\u52a8\u7684\u670d\u88c5\u8fc1\u79fb\u4f18\u5316\u95ee\u9898\u3002\u7b2c\u4e00\u9636\u6bb5\u5148\u4e0d\u4f18\u5316\u4e8c\u7ef4\u6837\u677f\uff0c\u800c\u662f\u5229\u7528 PyTorch \u548c PyTorch3D \u6c42\u51fa\u76ee\u6807\u4e09\u7ef4\u670d\u88c5\uff1b\u540e\u7eed\u518d\u4ee5\u8fd9\u4e2a\u4e09\u7ef4\u7ed3\u679c\u4e3a\u76ee\u6807\uff0c\u53cd\u6c42\u4e8c\u7ef4\u6837\u677f\u3002</p> <p>\u8fd9\u91cc\u6700\u5173\u952e\u7684\u662f\uff1a\u8ba9\u6e90\u670d\u88c5\u5230\u76ee\u6807\u670d\u88c5\u7684\u5c40\u90e8\u5f62\u53d8\u68af\u5ea6\uff0c\u5c3d\u53ef\u80fd\u63a5\u8fd1\u6e90\u4eba\u4f53\u5230\u76ee\u6807\u4eba\u4f53\u7684\u5c40\u90e8\u5f62\u53d8\u68af\u5ea6\uff0c\u540c\u65f6\u4fdd\u7559\u6e90\u670d\u88c5\u81ea\u8eab\u7684\u51e0\u4f55\u7ed3\u6784\u3002</p>"},{"location":"%E7%9B%B8%E5%85%B3%E6%80%A7%E8%AE%A1%E7%AE%97/%E7%AC%94%E8%AE%B0/#1","title":"1 \u4e00\u3001\u6574\u4f53\u7b97\u6cd5\u6d41\u7a0b","text":"<p>\u6e90\u4eba\u4f53 HsH_s \u4e0e\u76ee\u6807\u4eba\u4f53 HtH_t</p> <p>\u5efa\u7acb\u5bf9\u5e94\u4e09\u89d2\u5f62\u6216\u5c40\u90e8\u5bf9\u5e94\u5173\u7cfb</p> <p>\u8ba1\u7b97\u4eba\u4f53\u5c40\u90e8\u5f62\u53d8\u68af\u5ea6 FiHF_i^H</p> <p>\u63cf\u8ff0\u5c40\u90e8\u62c9\u4f38\u3001\u65cb\u8f6c\u548c\u526a\u5207</p> <p>\u8ba1\u7b97\u6e90\u670d\u88c5\u4e0e\u6e90\u4eba\u4f53\u7684\u5bf9\u5e94\u5173\u7cfb</p> <p>\u5efa\u7acb\u670d\u88c5\u9876\u70b9\u5230\u4eba\u4f53\u5c40\u90e8\u5f62\u53d8\u533a\u57df\u7684\u6620\u5c04</p> <p>PyTorch \u4f18\u5316\u76ee\u6807\u670d\u88c5 GtG_t</p> <p>\u4eba\u4f53\u5f62\u53d8\u68af\u5ea6\u4e00\u81f4\u6027 + \u670d\u88c5\u51e0\u4f55\u4fdd\u6301 + \u4eba\u4f53\u78b0\u649e\u7ea6\u675f</p> <p>\u8f93\u51fa\u76ee\u6807\u4e09\u7ef4\u670d\u88c5</p> <p>\u8fd9\u91cc\u4e0d\u9700\u8981\u5148\u6c42\u76ee\u6807\u6837\u677f\u3002\u4f60\u5148\u628a\u76ee\u6807\u4e09\u7ef4\u670d\u88c5\u505a\u6b63\u786e\uff0c\u540e\u9762\u518d\u628a\u5b83\u4f5c\u4e3a\u4e8c\u7ef4\u6837\u677f\u4f18\u5316\u7684\u53c2\u8003\u3002</p>"},{"location":"%E7%9B%B8%E5%85%B3%E6%80%A7%E8%AE%A1%E7%AE%97/%E7%AC%94%E8%AE%B0/#2","title":"2 \u4e8c\u3001\u7b2c\u4e00\u6b65\uff1a\u8ba1\u7b97\u4eba\u4f53\u7684\u5c40\u90e8\u5f62\u53d8\u68af\u5ea6","text":"<p>\u5047\u8bbe\u6e90\u4eba\u4f53\u548c\u76ee\u6807\u4eba\u4f53\u5177\u6709\u76f8\u540c\u62d3\u6251\uff0c\u5e76\u4e14\u9876\u70b9\u4e00\u4e00\u5bf9\u5e94\u3002\u5bf9\u4e8e\u6e90\u4eba\u4f53\u4e0a\u7684\u7b2c ii \u4e2a\u4e09\u89d2\u5f62\uff0c\u8bbe\u5176\u4e09\u4e2a\u9876\u70b9\u4e3a\uff1a</p> <p>p0s,p1s,p2s\\mathbf p_0^s,\\mathbf p_1^s,\\mathbf p_2^s</p> <p>\u76ee\u6807\u4eba\u4f53\u5bf9\u5e94\u9876\u70b9\u4e3a\uff1a</p> <p>p0t,p1t,p2t\\mathbf p_0^t,\\mathbf p_1^t,\\mathbf p_2^t</p> <p>\u9996\u5148\u6784\u9020\u4e24\u4e2a\u4e09\u7ef4\u8fb9\u77e9\u9635\uff1a</p> <p>Ds=[p1s\u2212p0sp2s\u2212p0s]D_s= \\begin{bmatrix} \\mathbf p_1^s-\\mathbf p_0^s &amp; \\mathbf p_2^s-\\mathbf p_0^s \\end{bmatrix}</p> <p>Dt=[p1t\u2212p0tp2t\u2212p0t]D_t= \\begin{bmatrix} \\mathbf p_1^t-\\mathbf p_0^t &amp; \\mathbf p_2^t-\\mathbf p_0^t \\end{bmatrix}</p> <p>\u7531\u4e8e\u4e09\u89d2\u5f62\u4f4d\u4e8e\u4e09\u7ef4\u7a7a\u95f4\u4e2d\uff0cDsD_s \u662f 3\u00d723\\times2 \u77e9\u9635\uff0c\u4e0d\u80fd\u76f4\u63a5\u5bf9\u5b83\u6c42\u666e\u901a\u9006\u77e9\u9635\u3002\u53ef\u4ee5\u5148\u4f7f\u7528\u4e09\u89d2\u5f62\u7684\u5c40\u90e8\u4e8c\u7ef4\u5750\u6807\u7cfb\uff0c\u8ba1\u7b97\u5176\u4e8c\u7ef4\u8fb9\u77e9\u9635 QsQ_s\uff0c\u7136\u540e\u6784\u9020\uff1a</p> <p>FiH=DtQs\u22121\\boxed{F_i^H=D_t Q_s^{-1}}</p> <p>\u5176\u4e2d\uff1a</p> <ul> <li> <p>Qs\u2208R2\u00d72Q_s\\in\\mathbb R^{2\\times2}\uff1a\u6e90\u4e09\u89d2\u5f62\u5728\u5c40\u90e8\u5207\u5e73\u9762\u4e0a\u7684\u8fb9\u77e9\u9635\u3002</p> </li> <li> <p>Dt\u2208R3\u00d72D_t\\in\\mathbb R^{3\\times2}\uff1a\u76ee\u6807\u4e09\u89d2\u5f62\u5bf9\u5e94\u8fb9\u77e9\u9635\u3002</p> </li> <li> <p>FiH\u2208R3\u00d72F_i^H\\in\\mathbb R^{3\\times2}\uff1a\u4ece\u6e90\u4eba\u4f53\u5c40\u90e8\u5207\u5e73\u9762\u5230\u76ee\u6807\u4eba\u4f53\u4e09\u7ef4\u7a7a\u95f4\u7684\u5f62\u53d8\u68af\u5ea6\u3002</p> </li> </ul> <p>\u8fd9\u79cd\u5b9a\u4e49\u9002\u5408\u4e09\u89d2\u5f62\u8868\u9762\u7684\u5c40\u90e8\u5f62\u53d8\u3002\u5b83\u63cf\u8ff0\u5207\u5411\u65b9\u5411\u7684\u62c9\u4f38\u3001\u65cb\u8f6c\u548c\u526a\u5207\uff0c\u4f46\u4e0d\u80fd\u76f4\u63a5\u63d0\u4f9b\u72ec\u7acb\u7684\u6cd5\u5411\u5f62\u53d8\u5206\u91cf\u3002</p> <p>\u5982\u679c\u4f60\u5e0c\u671b\u4f7f\u7528\u5b8c\u6574\u7684 3\u00d733\\times3 \u5f62\u53d8\u68af\u5ea6\uff0c\u9700\u8981\u4e3a\u6e90\u4eba\u4f53\u6784\u9020\u4e09\u7ef4\u5c40\u90e8\u57fa\u5e95\uff0c\u4f8b\u5982\u4e24\u6761\u5207\u5411\u57fa\u5411\u91cf\u52a0\u4e00\u6761\u6cd5\u5411\u57fa\u5411\u91cf\uff0c\u518d\u6839\u636e\u76ee\u6807\u5bf9\u5e94\u57fa\u5e95\u6784\u9020\u4e09\u7ef4\u53d8\u6362\u3002</p>"},{"location":"%E7%9B%B8%E5%85%B3%E6%80%A7%E8%AE%A1%E7%AE%97/%E7%AC%94%E8%AE%B0/#3","title":"3 \u4e09\u3001\u7b2c\u4e8c\u6b65\uff1a\u5efa\u7acb\u6e90\u670d\u88c5\u4e0e\u6e90\u4eba\u4f53\u7684\u76f8\u5173\u6027","text":"<p>\u8fd9\u662f\u6574\u4e2a\u65b9\u6cd5\u4e2d\u53e6\u4e00\u4e2a\u91cd\u8981\u6b65\u9aa4\u3002</p> <p>\u670d\u88c5\u9876\u70b9\u901a\u5e38\u4e0d\u5728\u4eba\u200b\u200b\u4f53\u8868\u9762\u4e0a\uff0c\u56e0\u6b64\u4e0d\u80fd\u7b80\u5355\u5730\u628a\u670d\u88c5\u9876\u70b9\u7d22\u5f15\u5f53\u4f5c\u4eba\u4f53\u9876\u70b9\u7d22\u5f15\u3002</p> <p>\u5bf9\u4e8e\u6e90\u670d\u88c5\u4e0a\u7684\u6bcf\u4e2a\u9876\u70b9 xis\\mathbf x_i^s\uff0c\u53ef\u4ee5\u627e\u5230\u6e90\u4eba\u4f53\u4e0a\u7684\u5bf9\u5e94\u4e09\u89d2\u5f62\uff0c\u5e76\u8bb0\u5f55\uff1a</p> <ul> <li> <p>\u5bf9\u5e94\u4eba\u4f53\u4e09\u89d2\u5f62\u7d22\u5f15 f(i)f(i)\uff1b</p> </li> <li> <p>\u5728\u4eba\u4f53\u4e09\u89d2\u5f62\u5c40\u90e8\u5750\u6807\u4e2d\u7684\u91cd\u5fc3\u5750\u6807\uff1b</p> </li> <li> <p>\u670d\u88c5\u9876\u70b9\u76f8\u5bf9\u4e8e\u4eba\u4f53\u8868\u9762\u7684\u504f\u79fb\uff1b</p> </li> <li> <p>\u5bf9\u5e94\u4e09\u89d2\u5f62\u7684\u5c40\u90e8\u5f62\u53d8\u68af\u5ea6\u3002</p> </li> </ul> <p>\u8fd9\u6837\u5c31\u80fd\u628a\u4eba\u4f53\u5f62\u53d8\u6620\u5c04\u5230\u670d\u88c5\u4e0a\u3002</p> <p>\u5982\u679c\u670d\u88c5\u9876\u70b9\u5bf9\u5e94\u4eba\u4f53\u4e09\u89d2\u5f62\u7684\u91cd\u5fc3\u5750\u6807\u4e3a \u03b20,\u03b21,\u03b22\\beta_0,\\beta_1,\\beta_2\uff0c\u5219\u5bf9\u5e94\u7684\u6e90\u3001\u76ee\u6807\u4eba\u4f53\u53c2\u8003\u70b9\u5206\u522b\u4e3a\uff1a</p> <p>qis=\u2211k=02\u03b2kpks\\mathbf q_i^s = \\sum_{k=0}^{2}\\beta_k\\mathbf p_k^s</p> <p>qit=\u2211k=02\u03b2kpkt\\mathbf q_i^t = \\sum_{k=0}^{2}\\beta_k\\mathbf p_k^t</p> <p>\u63a5\u4e0b\u6765\uff0c\u5229\u7528\u4eba\u4f53\u5c40\u90e8\u5f62\u53d8\u6620\u5c04\uff0c\u5c06\u670d\u88c5\u76f8\u5bf9\u4e8e\u4eba\u4f53\u7684\u504f\u79fb\u8fc1\u79fb\u8fc7\u53bb\u3002\u8fd9\u4f1a\u5f97\u5230\u4e00\u4e2a\u76ee\u6807\u670d\u88c5\u7684\u521d\u59cb\u4f4d\u7f6e\uff0c\u800c\u4e0d\u662f\u6700\u7ec8\u7ed3\u679c\u3002</p> <p>\u8fd9\u91cc\u9700\u8981\u6ce8\u610f\uff1a\u6700\u8fd1\u70b9\u6295\u5f71\u5f97\u5230\u7684\u4e09\u89d2\u5f62\u5bf9\u5e94\u5173\u7cfb\u53ef\u80fd\u5728\u814b\u4e0b\u3001\u88c6\u90e8\u7b49\u533a\u57df\u4ea7\u751f\u9519\u8bef\u6620\u5c04\u3002\u56e0\u6b64\u6700\u597d\u7ed3\u5408\u4eba\u4f53\u90e8\u4f4d\u3001\u6cd5\u7ebf\u65b9\u5411\u548c\u5c40\u90e8\u8fde\u7eed\u6027\u7b5b\u9009\u5bf9\u5e94\u5173\u7cfb\u3002</p>"},{"location":"%E7%9B%B8%E5%85%B3%E6%80%A7%E8%AE%A1%E7%AE%97/%E7%AC%94%E8%AE%B0/#4","title":"4 \u56db\u3001\u7b2c\u4e09\u6b65\uff1a\u5b9a\u4e49\u4eba\u4f53\u4e0e\u670d\u88c5\u7684\u5f62\u53d8\u68af\u5ea6\u4e00\u81f4\u6027\u635f\u5931","text":"<p>\u4f60\u63d0\u51fa\u7684\u6838\u5fc3\u7ea6\u675f\u662f\uff1a</p> <p>FiG\u2248FiHF_i^G\\approx F_i^H</p> <p>\u5176\u4e2d FiGF_i^G \u662f\u670d\u88c5\u4ece\u6e90\u72b6\u6001\u5230\u76ee\u6807\u72b6\u6001\u7684\u5c40\u90e8\u5f62\u53d8\u68af\u5ea6\u3002</p> <p>\u5bf9\u4e8e\u670d\u88c5\u4e09\u89d2\u5f62\uff0c\u6784\u9020\u6e90\u670d\u88c5\u5c40\u90e8\u4e8c\u7ef4\u8fb9\u77e9\u9635 QiGQ_i^G \u548c\u76ee\u6807\u670d\u88c5\u5bf9\u5e94\u8fb9\u77e9\u9635 DiGD_i^G\uff0c\u5b9a\u4e49\uff1a</p> <p>FiG=DiG(QiG)\u22121F_i<sup>G=D_i</sup>G(Q_i<sup>G)</sup>{-1}</p> <p>\u7136\u540e\u4f7f\u7528\u52a0\u6743 Frobenius \u8303\u6570\uff1a</p> <p>Lgrad=\u2211iwi\u2225FiG\u2212Ff(i)H\u2225F2\\boxed{ L_{\\mathrm{grad}} = \\sum_i w_i \\left| F_i<sup>G-F_{f(i)}</sup>H \\right|_F^2 }</p> <p>\u4e0d\u8fc7\uff0c\u8fd9\u91cc\u6709\u4e00\u4e2a\u5fc5\u987b\u89e3\u51b3\u7684\u6570\u5b66\u95ee\u9898\uff1a\u4eba\u4f53\u548c\u670d\u88c5\u7684\u4e09\u89d2\u5f62\u5177\u6709\u4e0d\u540c\u7684\u7a7a\u95f4\u4f4d\u7f6e\u3001\u65b9\u5411\u548c\u5c40\u90e8\u57fa\u5e95\uff0c\u56e0\u6b64\u4e0d\u80fd\u4e0d\u52a0\u5904\u7406\u5730\u76f4\u63a5\u6bd4\u8f83\u4e24\u4e2a\u77e9\u9635\u3002</p> <p>\u66f4\u7a33\u59a5\u7684\u505a\u6cd5\u662f\u5148\u5c06\u4eba\u4f53\u5f62\u53d8\u68af\u5ea6\u6620\u5c04\u5230\u670d\u88c5\u4e09\u89d2\u5f62\u7684\u5c40\u90e8\u5207\u5411\u57fa\u5e95\uff0c\u6216\u6bd4\u8f83\u4e24\u8005\u5728\u5bf9\u5e94\u5c40\u90e8\u65b9\u5411\u4e0a\u7684\u4f5c\u7528\u7ed3\u679c\u3002</p> <p>\u4f8b\u5982\uff0c\u5bf9\u4e8e\u670d\u88c5\u4e09\u89d2\u5f62\u7684\u6e90\u8fb9\u5411\u91cf e1s,e2s\\mathbf e_1^s,\\mathbf e_2^s\uff0c\u4eba\u4f53\u5f62\u53d8\u6620\u5c04\u53ef\u4ee5\u9884\u6d4b\uff1a</p> <p>e^kt=FiHeks\\hat{\\mathbf e}_k^t = F_i^H\\mathbf e_k^s</p> <p>\u8fd9\u91cc\u7684 FiHF_i^H \u5fc5\u987b\u4f5c\u7528\u4e8e\u4e0e\u5b83\u5b9a\u4e49\u57df\u4e00\u81f4\u7684\u5411\u91cf\uff1b\u5982\u679c\u670d\u88c5\u8fb9\u5411\u91cf\u4e0d\u662f\u4eba\u4f53\u5c40\u90e8\u5207\u5e73\u9762\u4e2d\u7684\u5411\u91cf\uff0c\u9700\u8981\u5148\u6295\u5f71\u6216\u8f6c\u6362\u5230\u5bf9\u5e94\u5c40\u90e8\u57fa\u5e95\u3002</p> <p>\u6700\u7ec8\u6bd4\u8f83\u9884\u6d4b\u8fb9\u5411\u91cf\u548c\u4f18\u5316\u540e\u7684\u76ee\u6807\u670d\u88c5\u8fb9\u5411\u91cf\uff1a</p> <p>Lgrad=\u2211i,kwik\u2225eikt\u2212FiHeiks\u22252\\boxed{ L_{\\mathrm{grad}} = \\sum_{i,k} w_{ik} \\left| \\mathbf e_{ik}^t- F_i^H\\mathbf e_{ik}^s \\right|^2 }</p> <p>\u8fd9\u79cd\u5199\u6cd5\u66f4\u52a0\u76f4\u63a5\uff0c\u4e5f\u66f4\u5bb9\u6613\u5728 PyTorch \u4e2d\u5b9e\u73b0\u3002</p>"},{"location":"%E7%9B%B8%E5%85%B3%E6%80%A7%E8%AE%A1%E7%AE%97/%E7%AC%94%E8%AE%B0/#5","title":"5 \u4e94\u3001\u5b8c\u6574\u7684\u4f18\u5316\u76ee\u6807","text":"<p>\u4ec5\u4f7f\u7528\u5f62\u53d8\u68af\u5ea6\u4e00\u81f4\u6027\u635f\u5931\u8fd8\u4e0d\u591f\u3002\u5426\u5219\uff0c\u670d\u88c5\u53ef\u80fd\u53d1\u751f\u5c40\u90e8\u7ffb\u8f6c\u3001\u5f02\u5e38\u62c9\u4f38\uff0c\u6216\u8005\u7a7f\u900f\u76ee\u6807\u4eba\u4f53\u3002</p> <p>\u6211\u5efa\u8bae\u4f7f\u7528\uff1a</p> <p>L=\u03bbgLgrad+\u03bbrLref+\u03bbsLsmooth+\u03bbbLbody+\u03bbcLcollision\\boxed{ L= \\lambda_g L_{\\mathrm{grad}} +\\lambda_r L_{\\mathrm{ref}} +\\lambda_s L_{\\mathrm{smooth}} +\\lambda_b L_{\\mathrm{body}} +\\lambda_c L_{\\mathrm{collision}} }</p> <p>\u5176\u4e2d\uff1a</p> <ul> <li> <p>LgradL_{\\mathrm{grad}}\uff1a\u670d\u88c5\u5f62\u53d8\u68af\u5ea6\u4e0e\u4eba\u4f53\u5f62\u53d8\u68af\u5ea6\u4e00\u81f4\u3002</p> </li> <li> <p>LrefL_{\\mathrm{ref}}\uff1a\u670d\u88c5\u63a5\u8fd1\u4eba\u4f53\u5f62\u53d8\u8fc1\u79fb\u5f97\u5230\u7684\u521d\u59cb\u53c2\u8003\u5f62\u72b6\u3002</p> </li> <li> <p>LsmoothL_{\\mathrm{smooth}}\uff1a\u4fdd\u6301\u670d\u88c5\u7f51\u683c\u7684\u5c40\u90e8\u5e73\u6ed1\u6027\u3002</p> </li> <li> <p>LbodyL_{\\mathrm{body}}\uff1a\u4fdd\u6301\u670d\u88c5\u4e0e\u76ee\u6807\u4eba\u4f53\u7684\u5408\u7406\u95f4\u8ddd\u3002</p> </li> <li> <p>LcollisionL_{\\mathrm{collision}}\uff1a\u60e9\u7f5a\u670d\u88c5\u7a7f\u900f\u4eba\u4f53\u3002</p> </li> </ul> <p>\u6211\u7279\u522b\u5efa\u8bae\u4fdd\u7559 LrefL_{\\mathrm{ref}}\u3002\u5b83\u80fd\u907f\u514d\u5355\u7eaf\u7684\u5c40\u90e8\u68af\u5ea6\u5339\u914d\u5bfc\u81f4\u670d\u88c5\u6574\u4f53\u6f02\u79fb\u3002</p> <p>\u5982\u679c\u540e\u7eed\u53d1\u73b0\u670d\u88c5\u8d34\u5408\u4e0d\u591f\u81ea\u7136\uff0c\u53ef\u4ee5\u518d\u589e\u52a0\u5c40\u90e8\u521a\u6027\u6216\u5f62\u72b6\u4fdd\u6301\u9879\uff0c\u4f46\u7b2c\u4e00\u7248\u5148\u4e0d\u8981\u5f15\u5165\u592a\u591a\u590d\u6742\u7ea6\u675f\u3002</p>"},{"location":"%E7%9B%B8%E5%85%B3%E6%80%A7%E8%AE%A1%E7%AE%97/%E7%AC%94%E8%AE%B0/#6-pytorch","title":"6 \u516d\u3001PyTorch \u4e2d\u7684\u4f18\u5316\u6838\u5fc3","text":"<p>\u4ee5\u4e0b\u662f\u5f62\u53d8\u68af\u5ea6\u635f\u5931\u7684\u4e00\u4e2a\u53ef\u5fae\u5b9e\u73b0\u3002\u8fd9\u91cc\u5047\u8bbe\u4f60\u5df2\u7ecf\u4e3a\u6bcf\u4e2a\u670d\u88c5\u4e09\u89d2\u5f62\u9884\u5148\u6784\u9020\u4e86\u6e90\u5c40\u90e8\u4e8c\u7ef4\u8fb9\u77e9\u9635\uff0c\u5e76\u4e14\u5df2\u7ecf\u628a\u4eba\u4f53\u5f62\u53d8\u68af\u5ea6\u8f6c\u6362\u5230\u4e86\u5bf9\u5e94\u7684\u670d\u88c5\u5c40\u90e8\u57fa\u5e95\u4e2d\u3002</p> <p>python</p> <pre><code>import torch\nimport torch.nn.functional as F\n\n\ndef garment_gradient_loss(\n    garment_target_verts,\n    garment_faces,\n    garment_source_verts,\n    source_local_inv,\n    body_gradient_on_garment,\n    weights=None,\n):\n    \"\"\"\n    garment_target_verts:       (N, 3), \u5f85\u4f18\u5316\u76ee\u6807\u670d\u88c5\u9876\u70b9\n    garment_faces:              (T, 3), \u670d\u88c5\u4e09\u89d2\u5f62\u7d22\u5f15\n    garment_source_verts:       (N, 3), \u6e90\u670d\u88c5\u9876\u70b9\n    source_local_inv:            (T, 2, 2), \u6e90\u670d\u88c5\u5c40\u90e8\u4e8c\u7ef4\u8fb9\u77e9\u9635\u7684\u9006\n    body_gradient_on_garment:    (T, 3, 2), \u6620\u5c04\u5230\u670d\u88c5\u5c40\u90e8\u57fa\u5e95\u7684\u4eba\u4f53\u68af\u5ea6\n    weights:                     (T,), \u53ef\u9009\u7684\u4e09\u89d2\u5f62\u6743\u91cd\n    \"\"\"\n    faces = garment_faces.long()\n\n    src_tri = garment_source_verts[faces]\n    dst_tri = garment_target_verts[faces]\n\n    # \u76ee\u6807\u670d\u88c5\u4e09\u89d2\u5f62\u7684\u4e09\u7ef4\u8fb9\u77e9\u9635 (T, 3, 2)\n    dst_edges = torch.stack(\n        [\n            dst_tri[:, 1] - dst_tri[:, 0],\n            dst_tri[:, 2] - dst_tri[:, 0],\n        ],\n        dim=-1,\n    )\n\n    # \u5f53\u524d\u670d\u88c5\u7684\u5c40\u90e8\u5f62\u53d8\u68af\u5ea6 (T, 3, 2)\n    garment_gradient = torch.bmm(\n        dst_edges, source_local_inv\n    )\n\n    # \u6ce8\u610f\uff1abody_gradient_on_garment \u5fc5\u987b\u5df2\u8f6c\u6362\u5230\u540c\u4e00\u4e2a\u5c40\u90e8\u57fa\u5e95\n    diff = garment_gradient - body_gradient_on_garment\n\n    per_face_loss = diff.square().sum(dim=(1, 2))\n\n    if weights is not None:\n        weights = weights.to(\n            device=per_face_loss.device,\n            dtype=per_face_loss.dtype,\n        )\n        return (weights * per_face_loss).sum() / weights.sum().clamp_min(1e-8)\n\n    return per_face_loss.mean()\n</code></pre> <p>\u8fd9\u91cc\u6709\u4e00\u4e2a\u5b9e\u73b0\u4e0a\u7684\u7ec6\u8282\uff1a<code>source_local_inv</code> \u5e94\u5f53\u6765\u81ea\u6bcf\u4e2a\u6e90\u670d\u88c5\u4e09\u89d2\u5f62\u7684\u4e8c\u7ef4\u5c40\u90e8\u53c2\u6570\u5316\uff0c\u800c\u4e0d\u662f\u76f4\u63a5\u5bf9\u4e09\u7ef4\u7684 3\u00d723\\times2 \u8fb9\u77e9\u9635\u6c42\u9006\u3002\u5426\u5219\u77e9\u9635\u7ef4\u5ea6\u4e0d\u5339\u914d\uff0c\u6570\u5b66\u5b9a\u4e49\u4e5f\u4e0d\u6b63\u786e\u3002</p> <p>\u6b64\u5916\uff0c<code>body_gradient_on_garment</code> \u4e0d\u80fd\u76f4\u63a5\u628a\u4eba\u4f53\u4e09\u89d2\u5f62\u7684 3\u00d723\\times2 \u68af\u5ea6\u590d\u5236\u8fc7\u6765\u3002\u4f60\u9700\u8981\u5148\u5c06\u4eba\u4f53\u5f62\u53d8\u6620\u5c04\u5230\u670d\u88c5\u4e09\u89d2\u5f62\u7684\u5c40\u90e8\u53c2\u6570\u65b9\u5411\uff0c\u518d\u4f20\u5165\u8be5\u51fd\u6570\u3002</p>"},{"location":"%E7%9B%B8%E5%85%B3%E6%80%A7%E8%AE%A1%E7%AE%97/%E7%AC%94%E8%AE%B0/#7","title":"7 \u4e03\u3001\u6211\u5efa\u8bae\u7684\u5b9e\u73b0\u987a\u5e8f","text":"<ol> <li> <p>\u8bfb\u53d6\u6e90\u4eba\u4f53\u3001\u76ee\u6807\u4eba\u4f53\u3001\u6e90\u670d\u88c5\u3002</p> </li> <li> <p>\u5efa\u7acb\u4eba\u4f53\u9876\u70b9\u6216\u4e09\u89d2\u5f62\u5bf9\u5e94\u5173\u7cfb\u3002</p> </li> <li> <p>\u8ba1\u7b97\u6bcf\u4e2a\u4eba\u4f53\u4e09\u89d2\u5f62\u7684\u5c40\u90e8\u5f62\u53d8\u68af\u5ea6\u3002</p> </li> <li> <p>\u4e3a\u6bcf\u4e2a\u6e90\u670d\u88c5\u9876\u70b9\u5efa\u7acb\u4eba\u4f53\u5bf9\u5e94\u4e09\u89d2\u5f62\u548c\u91cd\u5fc3\u5750\u6807\u3002</p> </li> <li> <p>\u8ba1\u7b97\u4eba\u4f53\u5f62\u53d8\u9a71\u52a8\u7684\u76ee\u6807\u670d\u88c5\u521d\u59cb\u4f4d\u7f6e\u3002</p> </li> <li> <p>\u5728 PyTorch \u4e2d\u4f18\u5316\u76ee\u6807\u670d\u88c5\u9876\u70b9\uff0c\u4f7f\u670d\u88c5\u5c40\u90e8\u68af\u5ea6\u5c3d\u91cf\u5339\u914d\u4eba\u4f53\u5c40\u90e8\u68af\u5ea6\u3002</p> </li> <li> <p>\u52a0\u5165\u53c2\u8003\u5f62\u72b6\u3001\u5e73\u6ed1\u3001\u95f4\u8ddd\u548c\u78b0\u649e\u635f\u5931\u3002</p> </li> <li> <p>\u4f7f\u7528 PyTorch3D \u53ef\u89c6\u5316\u3001\u68c0\u67e5\u5e76\u5bfc\u51fa\u76ee\u6807\u670d\u88c5\u3002</p> </li> </ol> <p>\u6700\u540e\u5f3a\u8c03\u4e00\u4e2a\u6838\u5fc3\u95ee\u9898\uff1a \u4f60\u7684\u65b9\u6cd5\u5e76\u4e0d\u662f\u8981\u6c42\u670d\u88c5\u548c\u4eba\u4f53\u7684\u5f62\u53d8\u68af\u5ea6\u5728\u6bcf\u4e2a\u4f4d\u7f6e\u90fd\u4e25\u683c\u76f8\u7b49\uff0c\u800c\u662f\u5e0c\u671b\u670d\u88c5\u7ee7\u627f\u4eba\u4f53\u7684\u4e3b\u8981\u5c40\u90e8\u5f62\u53d8\uff0c\u540c\u65f6\u4fdd\u7559\u670d\u88c5\u672c\u8eab\u7684\u677e\u91cf\u3001\u7ed3\u6784\u548c\u66f2\u9762\u7279\u5f81\u3002\u56e0\u6b64\u68af\u5ea6\u4e00\u81f4\u6027\u5e94\u8be5\u4f5c\u4e3a\u52a0\u6743\u8f6f\u7ea6\u675f\uff0c\u800c\u4e0d\u662f\u65e0\u6761\u4ef6\u7684\u786c\u7ea6\u675f\u3002\u8fd9\u6837\u624d\u80fd\u5f97\u5230\u66f4\u5408\u7406\u7684\u76ee\u6807\u670d\u88c5\uff0c\u4e5f\u4e3a\u540e\u7eed\u76ee\u6807\u6837\u677f\u53cd\u6c42\u63d0\u4f9b\u7a33\u5b9a\u7684\u4e09\u7ef4\u53c2\u8003\u3002</p>"},{"location":"%E8%99%9A%E6%8B%9F%E6%9C%8D%E8%A3%85%E8%BF%81%E7%A7%BB/%E8%99%9A%E6%8B%9F%E6%9C%8D%E8%A3%85%E8%BF%81%E7%A7%BB/","title":"\u865a\u62df\u670d\u88c5\u8fc1\u79fb","text":"<p>\u6d4b\u8bd5</p>"},{"location":"%E8%99%9A%E6%8B%9F%E6%A0%B7%E6%9D%BF%E8%BF%81%E7%A7%BB/%E8%99%9A%E6%8B%9F%E6%A0%B7%E6%9D%BF%E8%BF%81%E7%A7%BB/","title":"\u865a\u62df\u6837\u677f\u8fc1\u79fb","text":"<p>\u6211\u7684</p> <p>\u6837\u677f\u53d8\u5f62\u8fc1\u79fb \u6e90\u4eba\u4f53\uff0c\u76ee\u6807\u4eba\u4f53 \u6e90\u670d\u88c5\uff0c\u76ee\u6807\u670d\u88c5 \u6e90\u6837\u677f\uff0c\u76ee\u6807\u6837\u677f</p>"},{"location":"blog/","title":"Blog","text":""}]}